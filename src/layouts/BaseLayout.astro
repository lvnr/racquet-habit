---
import "@fontsource/instrument-serif/400.css";
import "@fontsource/instrument-serif/400-italic.css";
import "@fontsource-variable/geist/index.css";
import "@fontsource-variable/roboto-condensed/index.css";
import "../styles/global.css";
import "../styles/riviera.css";
import Header from "../components/Header.astro";
import CartDrawer from "../components/CartDrawer.astro";
import Footer from "../components/Footer.astro";
import ConsentBanner from "../components/ConsentBanner.astro";
import { productPresentation } from "../data/catalog";
import { env } from "cloudflare:workers";

type Props = {
  title?: string;
  description?: string;
  image?: string;
  robots?: string;
  pageType?: "website" | "article";
  bodyClass?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
};

const {
  title = "Tennis Apparel & Court Goods | Racquet Habit",
  description = "Shop Racquet Habit tennis apparel, court accessories and clubhouse goods for long lunches, late matches and repeat players, with worldwide delivery.",
  image = "/images/og-riviera-v2.jpg",
  robots = "index,follow,max-image-preview:large",
  pageType = "website",
  bodyClass = "",
  schema = [],
} = Astro.props;

const runtimeEnv = env as unknown as Record<string, string | undefined>;
const analyticsIds = {
  ga: runtimeEnv.GA_MEASUREMENT_ID || "G-B53YGNVTNF",
  meta: runtimeEnv.META_PIXEL_ID || "",
  tiktok: runtimeEnv.TIKTOK_PIXEL_ID || "D9HKESBC77U1LOVTV5E0",
  pinterest: runtimeEnv.PINTEREST_TAG_ID || "",
};
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
const baseSchema = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": "https://racquethabit.com/#organization",
    name: "Racquet Habit",
    url: "https://racquethabit.com",
    logo: {
      "@type": "ImageObject",
      url: "https://racquethabit.com/brand-white-court/wordmark-horizontal.webp",
    },
    slogan: "A difficult habit to break.",
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": "https://racquethabit.com/#website",
    name: "Racquet Habit",
    url: "https://racquethabit.com",
    publisher: { "@id": "https://racquethabit.com/#organization" },
  },
];
const pageSchema = Array.isArray(schema) ? schema : [schema];
const schemas = [...baseSchema, ...pageSchema.filter((item) => Object.keys(item).length > 0)];
const cartImageMap = Object.fromEntries(
  Object.entries(productPresentation)
    .map(([id, presentation]) => [id, presentation.catalogImages?.[0]])
    .filter((entry): entry is [string, string] => Boolean(entry[1])),
);
const cartImageMapJson = JSON.stringify(cartImageMap).replace(/</g, "\\u003c");
---

<!doctype html>
<html
  lang="en"
  data-ga-measurement-id={analyticsIds.ga}
  data-meta-pixel-id={analyticsIds.meta}
  data-tiktok-pixel-id={analyticsIds.tiktok}
  data-pinterest-tag-id={analyticsIds.pinterest}
>
  <head>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      window.gtag = window.gtag || gtag;
      gtag('consent', 'default', {
        ad_storage: 'denied',
        analytics_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        functionality_storage: 'granted',
        security_storage: 'granted',
        wait_for_update: 500,
      });
      gtag('set', 'ads_data_redaction', true);
      gtag('set', 'url_passthrough', true);
      try {
        const savedConsent = JSON.parse(localStorage.getItem('rh-consent-v1') || 'null');
        if (savedConsent?.version === 1 && savedConsent?.decided === true) {
          const marketingAllowed = Boolean(savedConsent.marketing) && navigator.globalPrivacyControl !== true;
          gtag('consent', 'update', {
            analytics_storage: savedConsent.analytics ? 'granted' : 'denied',
            ad_storage: marketingAllowed ? 'granted' : 'denied',
            ad_user_data: marketingAllowed ? 'granted' : 'denied',
            ad_personalization: marketingAllowed ? 'granted' : 'denied',
          });
        }
      } catch {}
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content={pageType} />
    <meta property="og:site_name" content="Racquet Habit" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="Racquet Habit court goods and tennis apparel" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Racquet Habit court goods and tennis apparel" />
    {schemas.map((item) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(item)}></script>
    ))}
    <slot name="head" />
    <title>{title}</title>
  </head>
  <body class:list={["white-court", bodyClass]}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CartDrawer />
    <ConsentBanner />
    <div class="toast" data-toast role="status" aria-live="polite"></div>
    <script is:inline id="cart-image-data" type="application/json" set:html={cartImageMapJson}></script>
    <script is:inline src="/scripts/consent-manager.js" type="module"></script>
    <script is:inline src="/scripts/marketing-pixels.js" type="module"></script>
    <script is:inline src="/scripts/commerce-analytics.js" type="module"></script>
    <script is:inline src="/scripts/storefront.js" type="module"></script>
  </body>
</html>
