---
import BaseLayout from "../layouts/BaseLayout.astro";
Astro.response.status = 404;
---

<BaseLayout title="Page Out — Racquet Habit">
  <section class="editorial-hero" style="min-height: 74svh; background: var(--ink)">
    <span class="eyebrow">Unforced error / 404</span>
    <h1>That page was <em>out.</em></h1>
    <p>The line call stands. Return to the issue or begin again from the baseline.</p>
    <div style="margin-top: 2rem; position: relative; z-index: 1"><a class="button button--acid" href="/">Return to court <span>↗</span></a></div>
  </section>
</BaseLayout>
