---
const path = Astro.url.pathname;
const links = [
  { href: "/shop", label: "Shop", active: path.startsWith("/shop") || path.startsWith("/products") },
  { href: "/journal", label: "Journal", active: path.startsWith("/journal") },
  { href: "/our-habit", label: "About", active: path === "/our-habit" },
];
---

<header class="riviera-header" data-site-header>
  <a class="riviera-header__brand" href="/" aria-label="Racquet Habit home">
    <img src="/brand-white-court/wordmark-horizontal.webp" alt="" aria-hidden="true" width="2000" height="575" />
  </a>

  <nav class="riviera-header__nav" aria-label="Primary navigation">
    {links.map((link) => <a class:list={{ active: link.active }} href={link.href}>{link.label}</a>)}
  </nav>

  <div class="riviera-header__actions">
    <span class="riviera-header__currency" aria-label="Prices in US dollars">USD $</span>
    <button class="riviera-header__bag" type="button" data-cart-open aria-label="Bag (0). Open shopping bag">
      Bag <span>(<span data-cart-count>0</span>)</span>
    </button>
    <details class="mobile-nav riviera-mobile-nav">
      <summary aria-label="Open navigation menu"><span></span><span></span></summary>
      <div class="riviera-mobile-nav__panel">
        <img class="riviera-mobile-nav__mark" src="/brand-white-court/monogram-thin.webp" alt="" width="1200" height="1200" />
        <nav aria-label="Mobile navigation">
          {links.map((link) => <a href={link.href}>{link.label}</a>)}
          <a href="/shipping">Delivery & returns</a>
          <a href="/contact">Contact</a>
        </nav>
        <div class="riviera-mobile-nav__foot">
          <span>Worldwide delivery · Free standard shipping on orders of $150+</span>
          <span>Currency · USD $</span>
        </div>
      </div>
    </details>
  </div>
</header>
