---
import BrandMark from "./BrandMark.astro";
---

<footer class="site-footer">
  <div class="site-footer__join">
    <span class="eyebrow">Court notices · new issues · recurring symptoms</span>
    <div class="site-footer__join-row">
      <h2>Enter the <em>society.</em></h2>
      <form action="https://racquet-habit-shop.fourthwall.com" method="get" class="join-form" data-join-form>
        <label class="sr-only" for="join-email">Email address</label>
        <input id="join-email" name="email" type="email" placeholder="YOUR EMAIL ADDRESS" autocomplete="email" required />
        <button type="submit">Request entry <span>↗</span></button>
      </form>
    </div>
  </div>
  <div class="site-footer__main">
    <BrandMark light />
    <div class="footer-links">
      <div>
        <span>Collection</span>
        <a href="/shop">Issue 001</a>
        <a href="/shop?category=Wear">Wear</a>
        <a href="/shop?category=Drink">Drink</a>
        <a href="/shop?category=Coffee">Coffee</a>
      </div>
      <div>
        <span>Society</span>
        <a href="/our-habit">Our habit</a>
        <a href="/journal/manifesto">Manifesto</a>
        <a href="/shipping">Delivery & returns</a>
      </div>
      <div>
        <span>Notices</span>
        <a href="mailto:levonarakelian@live.com">Contact</a>
        <a href="https://www.instagram.com/" rel="noreferrer">Instagram</a>
      </div>
    </div>
  </div>
  <div class="site-footer__bottom">
    <span>© {new Date().getFullYear()} Racquet Habit</span>
    <span>Yerevan · Armenia / Serving repeat players everywhere</span>
    <span>Play responsibly</span>
  </div>
</footer>
