---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Delivery & Returns — Racquet Habit" description="Racquet Habit delivery, duties and returns information for Armenia and international orders.">
  <section class="page-hero">
    <div class="page-hero__top eyebrow"><span>Delivery & returns</span><span>Updated July 2026</span></div>
    <h1>Court goods, <em>delivered.</em></h1>
    <div class="page-hero__bottom"><p>Made-to-order pieces ship through our production partners. Local collaborations may follow a separate, clearly marked timetable.</p></div>
  </section>
  <section class="shipping-grid">
    <article class="shipping-card"><b>AM</b><h2>Armenia</h2><p>Complimentary delivery across Armenia. Prices are shown in Armenian dram for convenience when you visit from Armenia; secure checkout currently settles in USD.</p></article>
    <article class="shipping-card"><b>INT</b><h2>International</h2><p>Fourthwall calculates the live delivery cost from order weight and destination. Destination duties and taxes are not included and may be collected by local authorities.</p></article>
    <article class="shipping-card"><b>R</b><h2>Returns</h2><p>Made-to-order items follow Fourthwall’s return and replacement policy. Contact us promptly for a defect, damage or fulfillment issue so the order can be reviewed.</p></article>
  </section>
  <p class="shipping-disclaimer">Delivery windows vary by product and destination and are shown again at checkout. Coffee and seasonal drink collaborations may be Armenia-only where freshness, licensing or cold-chain requirements make international shipping impractical.</p>
</BaseLayout>
