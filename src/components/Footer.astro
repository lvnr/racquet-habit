---
import BrandMark from "./BrandMark.astro";
---

<footer class="site-footer">
  <div class="site-footer__join">
    <div>
      <span class="eyebrow">The Society Register</span>
      <h2>One more set,<br /><em>in your inbox.</em></h2>
    </div>
    <form action="https://racquet-habit-shop.fourthwall.com" method="get" class="join-form" data-join-form>
      <p>New collections, court notes and occasional proof that the last set was never the last set.</p>
      <label class="sr-only" for="join-email">Email address</label>
      <div><input id="join-email" name="email" type="email" placeholder="EMAIL ADDRESS" autocomplete="email" required /><button type="submit">Join</button></div>
    </form>
  </div>
  <div class="site-footer__main">
    <BrandMark light />
    <div class="footer-links">
      <div><span>Collection</span><a href="/shop">The Last Set</a><a href="/shop?category=Wear">Wear</a><a href="/shop?category=Court">Court</a><a href="/shop?category=Coffee">Coffee</a></div>
      <div><span>Society</span><a href="/our-habit">About</a><a href="/journal/manifesto">Journal</a><a href="/shipping">Delivery & returns</a></div>
      <div><span>Contact</span><a href="mailto:levonarakelian@live.com">Email</a><a href="https://www.instagram.com/" rel="noreferrer">Instagram</a></div>
    </div>
  </div>
  <div class="site-footer__bottom"><span>© {new Date().getFullYear()} Racquet Habit</span><span>Yerevan · Armenia</span><span>A difficult habit to break.</span></div>
</footer>
