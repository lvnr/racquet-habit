---
import type { CatalogProduct } from "../data/catalog";
type Props = {
  product: CatalogProduct;
  index?: number;
  feature?: "standard" | "wide" | "compact";
  priority?: boolean;
};
const { product, index = 0, feature = "standard", priority = false } = Astro.props;
const priceLabel = product.maxPrice > product.price ? `From $${product.price.toFixed(0)}` : `$${product.price.toFixed(0)}`;
const galleryImages = [...new Set([
  product.image,
  ...product.images,
  product.editorialImage,
].filter((image): image is string => Boolean(image)))].slice(0, 4);
---

<article
  class:list={["annual-product-card", `annual-product-card--${feature}`]}
  data-product-card
  data-category={product.category}
  data-capsule={product.capsule}
>
  <div class="annual-product-card__media" data-card-gallery data-gallery-count={galleryImages.length}>
    <a
      class="annual-product-card__image"
      href={`/products/${product.slug}`}
      aria-label={`${String(index + 1).padStart(2, "0")}. View ${product.name}`}
      data-gallery-link
    >
      <span class="annual-product-card__number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
      <span class="annual-product-card__track" data-gallery-track>
        {galleryImages.map((image, imageIndex) => (
          <span
            class:list={["annual-product-card__slide", { "is-editorial": image === product.editorialImage }]}
            aria-hidden={imageIndex === 0 ? "false" : "true"}
          >
            <img
              src={image}
              alt={imageIndex === 0 ? product.name : `${product.name}, view ${imageIndex + 1}`}
              loading={priority && imageIndex === 0 ? "eager" : "lazy"}
              decoding="async"
              fetchpriority={priority && imageIndex === 0 ? "high" : "low"}
              width={image === product.editorialImage ? "1400" : "1536"}
              height={image === product.editorialImage ? "1400" : "2048"}
            />
          </span>
        ))}
      </span>
      <span class="annual-product-card__view" aria-hidden="true">View piece ↗</span>
    </a>
    {galleryImages.length > 1 && (
      <div class="annual-product-card__gallery-controls">
        <button type="button" data-gallery-prev aria-label={`Previous image of ${product.name}`}>←</button>
        <span data-gallery-status aria-live="polite">01 / {String(galleryImages.length).padStart(2, "0")}</span>
        <button type="button" data-gallery-next aria-label={`Next image of ${product.name}`}>→</button>
      </div>
    )}
  </div>
  <div class="annual-product-card__meta">
    <div>
      <span>{product.productType} · {product.capsule}</span>
      <h2><a href={`/products/${product.slug}`}>{product.name}</a></h2>
    </div>
    <strong data-price-usd={product.price}>{priceLabel}</strong>
  </div>
</article>
