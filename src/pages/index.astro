---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import { getCatalog } from "../lib/catalog";

const catalog = await getCatalog();
const featured = catalog.slice(0, 8);
const homeSchema = {
  "@context": "https://schema.org",
  "@type": "OnlineStore",
  "@id": "https://racquethabit.com/#store",
  name: "Racquet Habit",
  url: "https://racquethabit.com",
  description: "A tennis society and shop for considered apparel, court goods and clubhouse collaborations.",
  currenciesAccepted: "USD",
  areaServed: "Worldwide",
  parentOrganization: { "@id": "https://racquethabit.com/#organization" },
};
---

<BaseLayout
  title="Tennis Apparel & Court Goods | Racquet Habit"
  description="Shop Racquet Habit tennis apparel, court accessories and clubhouse goods for long lunches, late matches and repeat players, with worldwide delivery."
  schema={homeSchema}
>
  <section class="white-hero" aria-labelledby="white-hero-title">
    <div class="white-hero__copy">
      <img
        class="white-hero__wordmark"
        src="/brand-white-court/wordmark-horizontal.webp"
        alt="Racquet Habit"
        width="2000"
        height="575"
      />
      <div class="white-hero__statement">
        <h1 id="white-hero-title">Tennis goods for the hours around play.</h1>
        <p>Made for repeat players, late matches and whatever comes after.</p>
        <a class="text-link" href="/shop">Shop the collection <span aria-hidden="true">↗</span></a>
      </div>
      <div class="white-hero__service">
        <span>Worldwide delivery</span>
        <span>Free standard shipping over $150</span>
      </div>
    </div>
    <figure class="white-hero__image">
      <img
        src="/images/products/white-court/something-cold-organic-court-tote/editorial-02.webp"
        alt="A Racquet Habit player walking courtside with the Something Cold organic tote"
        fetchpriority="high"
        loading="eager"
        decoding="async"
        width="1024"
        height="1536"
      />
      <figcaption>Something Cold organic court tote</figcaption>
    </figure>
  </section>

  <section class="white-collection" aria-labelledby="new-arrivals-title">
    <header class="section-heading">
      <div>
        <h2 id="new-arrivals-title">The collection</h2>
        <span>{catalog.length || 24} pieces</span>
      </div>
      <a class="text-link" href="/shop">Shop all <span aria-hidden="true">↗</span></a>
    </header>
    {featured.length > 0 ? (
      <>
        <div
          class="annual-product-grid"
          data-commerce-list
          data-item-list-id="home_collection"
          data-item-list-name="Home — The collection"
        >
          {featured.map((product, index) => <ProductCard product={product} index={index} priority={index < 4} />)}
        </div>
        <div class="white-collection__cta">
          <a class="paper-button" href="/shop">
            Shop all {catalog.length} products <span aria-hidden="true">↗</span>
          </a>
        </div>
      </>
    ) : (
      <div class="catalog-unavailable">
        <h2>The live collection is between serves.</h2>
        <p>Please return shortly. We never show placeholder products.</p>
      </div>
    )}
  </section>

  <section class="court-story" aria-labelledby="court-story-title">
    <figure class="court-story__image court-story__image--large">
      <img
        src="/images/products/white-court/racquets-sunshine-something-bubbly-oversized-night-tee/editorial-02.webp"
        alt="A player wearing the black Racquets Sunshine Something Bubbly oversized tee on court"
        loading="lazy"
        decoding="async"
        width="1024"
        height="1536"
      />
    </figure>
    <div class="court-story__copy">
      <img src="/brand-white-court/monogram-bold-inverse.webp" alt="" aria-hidden="true" width="1200" height="1200" />
      <div>
        <h2 id="court-story-title">One more set.</h2>
        <p>Considered court uniforms and useful objects for people who rarely leave when the booking ends.</p>
        <a class="text-link text-link--light" href="/our-habit">Our habit <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <figure class="court-story__image">
      <img
        src="/images/products/white-court/out-of-office-court-cap/editorial-02.webp"
        alt="A player in the Out of Office court cap"
        loading="lazy"
        decoding="async"
        width="1024"
        height="1536"
      />
    </figure>
  </section>

  <section class="habit-field" aria-labelledby="habit-field-title">
    <div>
      <h2 id="habit-field-title">A difficult habit to break.</h2>
      <p>Racquet Habit is a tennis society and independent label for people who always play one more set.</p>
      <a class="paper-button" href="/journal">Read the court notes <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>
