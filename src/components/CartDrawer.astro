<dialog class="cart-drawer" data-cart-dialog aria-labelledby="bag-title">
  <form method="dialog" class="cart-drawer__head">
    <div>
      <span class="eyebrow">Shopping bag</span>
      <h2 id="bag-title">Your bag <sup data-cart-count>0</sup></h2>
    </div>
    <button type="submit" class="icon-button" aria-label="Close shopping bag">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 5 14 14M19 5 5 19" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>
    </button>
  </form>
  <div class="cart-drawer__body" data-cart-items></div>
  <div class="cart-empty" data-cart-empty>
    <img src="/brand-v3/illustrations/illustration-court-bag.svg" alt="" />
    <h3>Your bag is empty.</h3>
    <p>Collection 01 is ready when you are.</p>
    <a class="text-link" href="/shop">View the collection <span>↗</span></a>
  </div>
  <div class="cart-drawer__foot" data-cart-summary hidden>
    <div class="cart-total"><span>Estimated total</span><strong data-cart-total>$0.00</strong></div>
    <p data-cart-shipping>Free delivery in Armenia · International delivery calculated at checkout</p>
    <a class="button button--red button--full" href="#" data-cart-checkout>Secure checkout <span>↗</span></a>
    <small>Checkout and payment are handled by Fourthwall. AMD is an approximate display; orders settle in USD.</small>
  </div>
</dialog>
