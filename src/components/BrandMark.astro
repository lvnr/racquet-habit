---
type Props = { compact?: boolean; light?: boolean };
const { compact = false, light = false } = Astro.props;
---

<a class:list={["brand-mark", { compact, light }]} href="/" aria-label="Racquet Habit home">
  <svg viewBox="0 0 160 160" aria-hidden="true">
    <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
      <path d="M45 126V35h30.5c19.6 0 30.8 10.4 30.8 26.2S95.1 87.5 75.5 87.5H45m30.5 0L109 126M106.3 35v91M106.3 79h24M130.3 35v91" stroke-width="6"></path>
      <path class="brand-mark__orbit" d="M123.5 22.5C99 8.8 60.8 10.4 36.9 26.1 12.4 42.2 6.7 75.8 22.4 99.8" stroke-width="3"></path>
    </g>
  </svg>
  <span class="brand-mark__type">
    <span>Racquet Habit</span>
    {!compact && <small>Tennis Addicts Society</small>}
  </span>
</a>
