<footer class="riviera-footer">
  <div class="riviera-footer__register">
    <div>
      <img src="/brand-white-court/monogram-bold-inverse.webp" alt="" aria-hidden="true" width="1200" height="1200" />
      <h2>Court notes,<br />served irregularly.</h2>
    </div>
    <div class="riviera-footer__register-copy">
      <p>New uniforms, court notes and the occasional excuse to remain out of office.</p>
      <form class="court-notes-form" data-newsletter-form data-clarity-mask="true">
        <label for="court-notes-email">Email address</label>
        <div>
          <input
            id="court-notes-email"
            name="email"
            type="email"
            autocomplete="email"
            inputmode="email"
            placeholder="you@example.com"
            aria-describedby="court-notes-terms court-notes-status"
            required
          />
          <button class="paper-button paper-button--light" type="submit">Join</button>
        </div>
        <input class="court-notes-form__honeypot" name="company" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <input name="startedAt" type="hidden" />
        <small id="court-notes-terms">By joining, you agree to receive marketing emails. Unsubscribe whenever the rally ends.</small>
        <p id="court-notes-status" class="court-notes-form__status" data-newsletter-status role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>

  <div class="riviera-footer__scorecard">
    <div class="scorecard-brand">
      <img src="/brand-white-court/wordmark-horizontal.webp" alt="Racquet Habit" width="2000" height="575" />
      <p>Tennis goods for repeat players and the hours around play.</p>
    </div>
    <nav aria-label="Shop">
      <span>Shop</span>
      <a href="/shop">All products</a>
      <a href="/shop?category=Tees">Tees</a>
      <a href="/shop?category=Accessories">Accessories</a>
    </nav>
    <nav aria-label="Society">
      <span>Society</span>
      <a href="/our-habit">About</a>
      <a href="/journal">Journal</a>
      <a href="/shipping">Delivery & returns</a>
    </nav>
    <nav aria-label="Help">
      <span>Help</span>
      <a href="/contact">Contact</a>
      <a href="/privacy">Privacy</a>
      <a href="/terms">Terms</a>
      <button class="footer-privacy-button" type="button" data-consent-settings>Cookie settings</button>
    </nav>
    <nav aria-label="Social media">
      <span>Social</span>
      <a href="https://www.instagram.com/racquethabit/" target="_blank" rel="me noopener noreferrer">Instagram</a>
      <a href="https://www.tiktok.com/@racquethabit" target="_blank" rel="me noopener noreferrer">TikTok</a>
      <a href="https://www.pinterest.com/racquethabit/" target="_blank" rel="me noopener noreferrer">Pinterest</a>
      <a href="https://www.facebook.com/racquethabit/" target="_blank" rel="me noopener noreferrer">Facebook</a>
    </nav>
  </div>

  <div class="riviera-footer__bottom">
    <span>© {new Date().getFullYear()} Racquet Habit</span>
    <span>Yerevan · Armenia</span>
    <span>A difficult habit to break.</span>
  </div>
</footer>
<script is:inline src="/scripts/newsletter.js" type="module"></script>
