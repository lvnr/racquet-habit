{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "racquet-habit-commerce-ops",
  "main": "workers/commerce-ops.ts",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "RH_OBSERVABILITY_DB",
      "database_name": "racquet-habit-observability",
      "database_id": "e353b397-a658-4705-b1cf-5a5584b931e3",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "SENTRY_DSN": "https://bc79d15ac4f51d17971f8b596faeb64e@o4511829624553472.ingest.de.sentry.io/4511829654372432",
    "STOREFRONT_URL": "https://racquethabit.com",
    "CANARY_PRODUCT_PATH": "/products/signed-rally-founding-issue-crop-tee"
  },
  "triggers": {
    "crons": ["*/30 * * * *", "15 8 * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
