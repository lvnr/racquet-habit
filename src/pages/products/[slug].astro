---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductCard from "../../components/ProductCard.astro";
import EditorialImage from "../../components/EditorialImage.astro";
import { getCatalog, getProduct } from "../../lib/catalog";

const product = await getProduct(Astro.params.slug || "");
if (!product) return Astro.rewrite("/404");
const catalog = await getCatalog();
const variants = product.variants.filter((variant) => variant.inStock);
const defaultVariant = variants[0];
const maxProductGalleryImages = 6;
const initialImages = product.images.slice(0, maxProductGalleryImages);
const productGallerySlots = Array.from({ length: maxProductGalleryImages }, (_, index) => initialImages[index]);
const colors = [...new Map(variants.filter((variant) => variant.color).map((variant) => [variant.color, variant.colorHex])).entries()];
const sizes = [...new Set(variants.map((variant) => variant.size).filter((value): value is string => Boolean(value)))];
const related = catalog
  .filter((item) => item.id !== product.id)
  .sort((a, b) => Number(b.capsule === product.capsule) - Number(a.capsule === product.capsule))
  .slice(0, 3);
const canonical = `https://racquethabit.com/products/${product.slug}`;
const variantSchema = variants.map((variant) => ({
  "@type": "Product",
  name: `${product.name} — ${variant.name}`,
  sku: variant.id,
  color: variant.color,
  size: variant.size,
  image: variant.images,
  offers: {
    "@type": "Offer",
    url: canonical,
    priceCurrency: "USD",
    price: variant.price,
    availability: "https://schema.org/InStock",
    seller: { "@id": "https://racquethabit.com/#organization" },
  },
}));
const productSchema = variants.length > 1 ? {
  "@context": "https://schema.org",
  "@type": "ProductGroup",
  "@id": `${canonical}#product`,
  productGroupID: product.id,
  name: product.name,
  description: product.description,
  url: canonical,
  image: product.images,
  brand: { "@type": "Brand", name: "Racquet Habit" },
  category: `${product.category} > ${product.productType}`,
  variesBy: [
    ...(colors.length > 1 ? ["https://schema.org/color"] : []),
    ...(sizes.length > 1 ? ["https://schema.org/size"] : []),
  ],
  hasVariant: variantSchema,
} : {
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": `${canonical}#product`,
  name: product.name,
  sku: defaultVariant?.id || product.id,
  description: product.description,
  url: canonical,
  image: product.images,
  brand: { "@type": "Brand", name: "Racquet Habit" },
  category: `${product.category} > ${product.productType}`,
  offers: variantSchema[0]?.offers,
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Shop", item: "https://racquethabit.com/shop" },
    { "@type": "ListItem", position: 2, name: product.category, item: `https://racquethabit.com/shop?category=${product.category}` },
    { "@type": "ListItem", position: 3, name: product.name, item: canonical },
  ],
};
const optionsJson = JSON.stringify({
  variants,
  featuredColor: product.featuredColor,
  featuredSize: product.featuredSize,
  featuredGallery: initialImages,
  editorialStartIndex: product.catalogImages.length,
  productType: product.productType,
}).replace(/</g, "\\u003c");
const productDescription = `${product.description} Shop ${product.name} by Racquet Habit with worldwide delivery.`;
---

<BaseLayout
  title={`${product.name} | Racquet Habit`}
  description={productDescription}
  image={product.editorialImage || product.image}
  schema={[productSchema, breadcrumbSchema]}
  bodyClass="product-detail-page"
>
  <section
    class="annual-product-page"
    data-product-detail
    data-commerce-item
    data-item-id={product.id}
    data-item-name={product.name}
    data-item-price={defaultVariant?.price ?? product.price}
    data-item-category={product.category}
    data-item-type={product.productType}
    data-item-capsule={product.capsule}
    data-item-variant={defaultVariant?.name || ""}
  >
    <div class="annual-product-gallery-shell" data-pdp-gallery>
      <div class="annual-product-gallery" data-product-gallery>
        {productGallerySlots.map((image, index) => (
          <figure
            class:list={{ "annual-product-gallery__editorial": Boolean(image && product.editorialImages.includes(image)) }}
            data-gallery-slot={index}
            hidden={!image}
          >
            <img
              src={image || product.image}
              alt={index === 0 ? product.name : `${product.name}, view ${index + 1}`}
              fetchpriority={index === 0 ? "high" : "low"}
              loading={index === 0 ? "eager" : "lazy"}
              decoding="async"
              width="1536"
              height="2048"
            />
            <figcaption>
              <span data-gallery-kind>{image && product.editorialImages.includes(image) ? "From the annual" : product.productType}</span>
              <span data-gallery-view>{image && product.editorialImages.includes(image) ? "Editorial" : `View ${String(index + 1).padStart(2, "0")}`}</span>
            </figcaption>
          </figure>
        ))}
      </div>
      <div class="annual-product-gallery__controls">
        <button type="button" data-pdp-gallery-prev aria-label="Previous product image">←</button>
        <span data-pdp-gallery-status aria-live="polite">
          01 / {String(initialImages.length).padStart(2, "0")}
        </span>
        <button type="button" data-pdp-gallery-next aria-label="Next product image">→</button>
      </div>
    </div>

    <div class="annual-product-info">
      <nav class="product-breadcrumb" aria-label="Breadcrumb">
        <a href="/shop">Collection 01</a><span>/</span><a href={`/shop?category=${product.category}`}>{product.category}</a>
      </nav>
      <span class="site-kicker">{product.capsule} · {product.productType}</span>
      <div class="annual-product-info__title">
        <h1>{product.name}</h1>
        <strong data-product-price data-price-usd={defaultVariant?.price ?? product.price}>${(defaultVariant?.price ?? product.price).toFixed(2)}</strong>
      </div>
      <p class="annual-product-info__description">{product.description}</p>

      <div class="product-options">
        {colors.length > 1 && (
          <fieldset class="color-options">
            <legend>Color <span data-selected-color>{defaultVariant?.color}</span></legend>
            <div>
              {colors.map(([color, hex], index) => (
                <button
                  type="button"
                  class:list={{ active: index === 0 }}
                  data-color-option={color}
                  aria-label={color}
                  aria-pressed={index === 0 ? "true" : "false"}
                  title={color}
                >
                  <i style={`--swatch:${hex || "#eee6d3"}`}></i>
                </button>
              ))}
            </div>
          </fieldset>
        )}

        {sizes.length > 1 && (
          <label class="size-option" for="product-size">
            <span>{product.productType === "MagSafe case" ? "Device" : "Size"}</span>
            <select id="product-size" data-size-select>
              {sizes.map((size) => <option value={size}>{size}</option>)}
            </select>
          </label>
        )}
      </div>

      <button
        class="paper-button paper-button--red paper-button--full"
        type="button"
        data-add-to-cart
        data-variant-id={defaultVariant?.id}
        data-product-id={product.id}
        data-name={product.name}
        data-variant={defaultVariant?.name}
        data-price={defaultVariant?.price ?? product.price}
        data-image={initialImages[0] || product.image}
        data-category={product.category}
        data-product-type={product.productType}
        data-capsule={product.capsule}
      >
        <span>Add to bag</span><span>↗</span>
      </button>
      <p class="product-note">Made to order. Local-currency display is approximate; secure checkout settles in USD.</p>

      <div class="product-answer">
        <h2>At a glance</h2>
        <dl>
          <div><dt>Availability</dt><dd>Available now · made to order</dd></div>
          <div><dt>Options</dt><dd>{colors.length || 1} {colors.length === 1 ? "color" : "colors"} · {sizes.length || 1} {product.productType === "MagSafe case" ? "device options" : sizes.length === 1 ? "size" : "sizes"}</dd></div>
          <div><dt>Delivery</dt><dd>Worldwide · live timing at checkout</dd></div>
          <div><dt>Returns</dt><dd>Quality issues covered; general and sizing returns are not accepted</dd></div>
        </dl>
      </div>

      <div class="product-accordions">
        <details open>
          <summary>The piece</summary>
          <p>{product.story}</p>
        </details>
        {product.information.map((item) => (
          <details>
            <summary>{item.title}</summary>
            {item.body && <p>{item.body}</p>}
            {item.link && <a href={item.link} target="_blank" rel="noreferrer">{item.linkLabel || "Learn more"} ↗</a>}
          </details>
        ))}
        <details>
          <summary>Delivery & order support</summary>
          <p>Production and delivery timing are calculated from the item and destination at checkout. Tracking and order-support links are included in your confirmation email.</p>
          <a href="/shipping">Read delivery & returns ↗</a>
        </details>
      </div>
    </div>
  </section>

  <section class="product-context" aria-labelledby="annual-context-title">
    <div>
      <span class="site-kicker">From the annual · not an additional product view</span>
      <h2 id="annual-context-title">Made for the<br /><em>hours around play.</em></h2>
      <p>Issue 01 begins in the shade, travels through a late court booking and normally ends wherever lunch is still being served.</p>
    </div>
    <EditorialImage
      src={product.category === "Accessories" ? "/images/editorial/accessories-flat-lay.webp" : "/images/editorial/locker-campaign-v2.webp"}
      alt={product.category === "Accessories" ? "Racquet Habit court accessories arranged beside tennis equipment" : "Four Racquet Habit players wearing pieces from Collection 01 in a locker contact sheet"}
      caption={product.category === "Accessories" ? "Equipment for the hours after" : "Five pieces · one locker call"}
      plate="Annual context"
    />
  </section>

  {related.length > 0 && (
    <section class="related-annual">
      <header>
        <span class="site-kicker">Continue the draw</span>
        <h2>More from Issue 01</h2>
        <a class="paper-link" href="/shop">View all twelve pieces <span>↗</span></a>
      </header>
      <div
        class="annual-product-grid"
        data-commerce-list
        data-item-list-id="related_products"
        data-item-list-name={`Related to ${product.name}`}
      >
        {related.map((item, index) => <ProductCard product={item} index={index} />)}
      </div>
    </section>
  )}

  <script is:inline id="product-options-data" type="application/json" set:html={optionsJson}></script>
  <script>
    const dataNode = document.querySelector<HTMLScriptElement>("#product-options-data");
    const galleryData = JSON.parse(dataNode?.textContent || "{}");
    const variants = galleryData.variants || [];
    const featuredColor = galleryData.featuredColor || "";
    const featuredSize = galleryData.featuredSize || "";
    const featuredGallery = galleryData.featuredGallery || [];
    const editorialStartIndex = galleryData.editorialStartIndex || 2;
    const productType = galleryData.productType || "Product";
    const colorButtons = [...document.querySelectorAll<HTMLButtonElement>("[data-color-option]")];
    const sizeSelect = document.querySelector("[data-size-select]") as any;
    const colorLabel = document.querySelector<HTMLElement>("[data-selected-color]");
    const addButton = document.querySelector<HTMLButtonElement>("[data-add-to-cart]");
    const price = document.querySelector<HTMLElement>("[data-product-price]");
    const gallery = document.querySelector<HTMLElement>("[data-product-gallery]");
    const galleryShell = document.querySelector<HTMLElement>("[data-pdp-gallery]");
    const galleryStatus = galleryShell?.querySelector<HTMLElement>("[data-pdp-gallery-status]");
    const galleryPrevious = galleryShell?.querySelector<HTMLButtonElement>("[data-pdp-gallery-prev]");
    const galleryNext = galleryShell?.querySelector<HTMLButtonElement>("[data-pdp-gallery-next]");
    let selectedColor = colorButtons.find((button) => button.classList.contains("active"))?.dataset.colorOption || variants[0]?.color;

    const availableSizes = (color: string) => variants.filter((variant: any) => !color || variant.color === color).map((variant: any) => variant.size);
    const visibleFigures = () => gallery ? [...gallery.querySelectorAll<HTMLElement>("figure:not([hidden])")] : [];
    const currentFigureIndex = () => {
      const figures = visibleFigures();
      if (!gallery || !figures.length) return 0;
      return figures.reduce((nearest, figure, index) => {
        const distance = Math.abs(figure.offsetLeft - gallery.scrollLeft);
        return distance < nearest.distance ? { index, distance } : nearest;
      }, { index: 0, distance: Number.POSITIVE_INFINITY }).index;
    };
    const updateGalleryStatus = () => {
      const figures = visibleFigures();
      const current = currentFigureIndex();
      if (galleryStatus) galleryStatus.textContent = `${String(current + 1).padStart(2, "0")} / ${String(figures.length).padStart(2, "0")}`;
      if (galleryPrevious) galleryPrevious.disabled = current <= 0;
      if (galleryNext) galleryNext.disabled = current >= figures.length - 1;
    };
    const moveGallery = (direction: number) => {
      const figures = visibleFigures();
      const nextIndex = Math.max(0, Math.min(figures.length - 1, currentFigureIndex() + direction));
      const figure = figures[nextIndex];
      if (!gallery || !figure) return;
      gallery.scrollTo({ left: figure.offsetLeft, behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
    };

    galleryPrevious?.addEventListener("click", () => moveGallery(-1));
    galleryNext?.addEventListener("click", () => moveGallery(1));
    let galleryFrame = 0;
    gallery?.addEventListener("scroll", () => {
      if (galleryFrame) return;
      galleryFrame = window.requestAnimationFrame(() => {
        updateGalleryStatus();
        galleryFrame = 0;
      });
    }, { passive: true });

    const renderVariant = () => {
      if (sizeSelect && !availableSizes(selectedColor).includes(sizeSelect.value)) {
        sizeSelect.value = availableSizes(selectedColor)[0] || sizeSelect.options[0]?.value;
      }
      [...(sizeSelect?.options || [])].forEach((option) => {
        option.disabled = Boolean(selectedColor) && !availableSizes(selectedColor).includes(option.value);
      });
      const variant = variants.find((item: any) =>
        (!selectedColor || item.color === selectedColor) &&
        (!sizeSelect?.value || item.size === sizeSelect.value)
      ) || variants.find((item: any) => !selectedColor || item.color === selectedColor) || variants[0];
      if (!variant) return;
      if (price) {
        price.dataset.priceUsd = String(variant.price);
        price.textContent = new Intl.NumberFormat("en-US", { style: "currency", currency: "USD" }).format(variant.price);
      }
      const showFeaturedGallery =
        selectedColor === featuredColor &&
        (!featuredSize || !sizeSelect?.value || sizeSelect.value === featuredSize);
      const images = showFeaturedGallery && featuredGallery.length
        ? featuredGallery
        : (variant.images?.length ? variant.images : featuredGallery);
      if (addButton) {
        addButton.dataset.variantId = variant.id;
        addButton.dataset.variant = variant.name;
        addButton.dataset.price = String(variant.price);
        addButton.dataset.image = images[0] || addButton.dataset.image;
      }
      const productDetail = document.querySelector<HTMLElement>("[data-product-detail]");
      if (productDetail) {
        productDetail.dataset.itemPrice = String(variant.price);
        productDetail.dataset.itemVariant = variant.name;
      }
      if (gallery) {
        const figures = [...gallery.querySelectorAll<HTMLElement>("[data-gallery-slot]")];
        figures.forEach((figure, index) => {
          figure.hidden = !images[index];
          const img = figure.querySelector<HTMLImageElement>("img");
          const editorial = showFeaturedGallery && index >= editorialStartIndex;
          figure.classList.toggle("annual-product-gallery__editorial", editorial);
          if (img && images[index]) {
            img.src = images[index];
            img.alt = editorial
              ? `${addButton?.dataset.name || ""} photographed for the Racquet Habit annual`
              : index === 0 ? addButton?.dataset.name || "" : `${addButton?.dataset.name || ""}, view ${index + 1}`;
          }
          const kind = figure.querySelector<HTMLElement>("[data-gallery-kind]");
          const view = figure.querySelector<HTMLElement>("[data-gallery-view]");
          if (kind) kind.textContent = editorial ? "From the annual" : productType;
          if (view) view.textContent = editorial ? "Editorial" : `View ${String(index + 1).padStart(2, "0")}`;
        });
        gallery.scrollTo({ left: 0, behavior: "auto" });
        window.requestAnimationFrame(updateGalleryStatus);
      }
    };

    colorButtons.forEach((button) => button.addEventListener("click", () => {
      selectedColor = button.dataset.colorOption || "";
      colorButtons.forEach((item) => {
        const active = item === button;
        item.classList.toggle("active", active);
        item.setAttribute("aria-pressed", String(active));
      });
      if (colorLabel) colorLabel.textContent = selectedColor;
      renderVariant();
    }));
    sizeSelect?.addEventListener("change", renderVariant);
    renderVariant();
    updateGalleryStatus();
  </script>
</BaseLayout>
