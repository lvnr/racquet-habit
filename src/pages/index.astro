---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import { getCatalog } from "../lib/catalog";

const catalog = await getCatalog();
const featured = catalog.filter((product) => !product.comingSoon).slice(0, 4);
const marqueePhrases = ["One more set", "Membership is involuntary", "Habit-forming since 2026", "Play responsibly"];
---

<BaseLayout>
  <section class="hero">
    <div class="hero__image">
      <picture>
        <source srcset="/images/hero-night-court.avif" type="image/avif" />
        <source srcset="/images/hero-night-court.webp" type="image/webp" />
        <img src="/images/hero-night-court.png" alt="Tennis player resting beside a dark court after sunset" fetchpriority="high" />
      </picture>
      <span class="hero__side-note">Court time 21:47<br />Status: still active</span>
    </div>
    <div class="hero__content">
      <div>
        <span class="eyebrow hero__eyebrow"><span>Racquet Habit</span><i>/</i><span>Issue 001</span><i>/</i><span class="hero__eyebrow-date">Established 2026</span></span>
        <h1 class="hero__title"><span>A difficult</span><span>habit.</span></h1>
        <p class="hero__intro">A contemporary tennis society for repeat players. Apparel, court goods and clubhouse rituals for people with no intention of quitting.</p>
        <div class="hero__actions">
          <a class="button button--acid" href="/shop">View Issue 001 <span>↗</span></a>
          <a class="button button--light" href="/our-habit">Read our condition <span>↗</span></a>
        </div>
      </div>
      <div class="hero__footer">
        <span>Yerevan, AM / Serving repeat players everywhere</span>
        <span>Scroll to examine symptoms ↓</span>
      </div>
      <div class="hero__seal" aria-hidden="true">
        <svg viewBox="0 0 160 160"><path d="M45 126V35h30.5c19.6 0 30.8 10.4 30.8 26.2S95.1 87.5 75.5 87.5H45m30.5 0L109 126M106.3 35v91M106.3 79h24M130.3 35v91" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        <span>Est. 2026</span>
      </div>
    </div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      {[...marqueePhrases, ...marqueePhrases].map((phrase) => <><span>{phrase}</span><i></i></>)}
    </div>
  </div>

  <section class="collection-preview">
    <header class="section-heading">
      <span class="section-heading__number">01 / The uniform</span>
      <h2>Issue <em>001</em></h2>
      <p>Founding pieces designed with court geometry, ritual detail and just enough irreverence to reward a second look.</p>
    </header>
    <div class="product-grid">
      {featured.map((product, index) => <ProductCard product={product} index={index} />)}
    </div>
    <a class="text-link" href="/shop">Examine the full issue <span>↗</span></a>
  </section>

  <section class="manifesto-slab">
    <svg class="manifesto-slab__orbit" viewBox="0 0 160 160" aria-hidden="true"><path d="M45 126V35h30.5c19.6 0 30.8 10.4 30.8 26.2S95.1 87.5 75.5 87.5H45m30.5 0L109 126M106.3 35v91M106.3 79h24M130.3 35v91" fill="none" stroke="currentColor" stroke-width="4"></path><path d="M123.5 22.5C99 8.8 60.8 10.4 36.9 26.1 12.4 42.2 6.7 75.8 22.4 99.8" fill="none" stroke="currentColor" stroke-width="2"></path></svg>
    <div class="manifesto-slab__copy">
      <span class="eyebrow">Society principle no. 01</span>
      <blockquote>One more set is <em>never</em> one more set.</blockquote>
      <div class="manifesto-slab__foot">
        <p>The brand looks serious at first. The truth appears in the small print: court time is non-negotiable and membership is, for practical purposes, involuntary.</p>
        <a class="button button--light" href="/journal/manifesto">Read the manifesto <span>↗</span></a>
      </div>
    </div>
  </section>

  <section class="clubhouse">
    <div class="clubhouse__visual">
      <img src="/images/product-coffee.svg" alt="After Set limited roast concept packaging" loading="lazy" />
      <span class="clubhouse__stamp">Guest roaster<br />Issue 001<br />Coming soon</span>
    </div>
    <div class="clubhouse__copy">
      <span class="eyebrow">Beyond the baseline</span>
      <h2>The clubhouse ritual.</h2>
      <p>Our rotating coffee and seasonal drink collaborations extend the habit beyond play. The first partner release will be roasted and served in Armenia, then offered in limited numbered lots.</p>
      <div class="clubhouse__details">
        <div><span>Release</span><b>Guest roaster 001</b></div>
        <div><span>Format</span><b>250 g / whole bean</b></div>
        <div><span>Status</span><b>Currently in development</b></div>
      </div>
      <a class="text-link" href="/shop?category=Coffee">Follow the collaboration <span>↗</span></a>
    </div>
  </section>
</BaseLayout>
