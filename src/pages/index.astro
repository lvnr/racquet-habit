---
import BaseLayout from "../layouts/BaseLayout.astro";
import RivieraProductPlate from "../components/RivieraProductPlate.astro";
import { getCatalog } from "../lib/catalog";
import type { CatalogProduct } from "../data/catalog";
import "../styles/riviera.css";

const catalog = await getCatalog();
const preferredSlugs = [
  "tennis-lunch-tennis-tee",
  "something-cold-organic-court-tote",
  "out-of-office-court-cap",
];

const exactProducts = preferredSlugs
  .map((slug) => catalog.find((product) => product.slug === slug))
  .filter((product): product is CatalogProduct => Boolean(product));
const products = exactProducts.length === 3 ? exactProducts : catalog.filter((product) => !product.comingSoon).slice(0, 3);
const localImages = [
  "/images/riviera/tennis-lunch-tee.webp",
  "/images/riviera/something-cold-tote.webp",
  "/images/riviera/on-court-cap.webp",
];
---

<BaseLayout
  title="Racquet Habit — Long Lunch. Late Match."
  description="Racquet Habit court goods for long lunches, late matches and everything between."
  image="/images/riviera/laundry-hero-desktop.webp"
  headerVariant="riviera"
  bodyClass="riviera-page"
  noFooter={true}
>
  <div class="riviera-spread">
    <section class="riviera-hero" aria-labelledby="riviera-title">
      <div class="riviera-hero__copy">
        <div class="riviera-hero__kicker">
          <span>Riviera Match Annual</span>
          <span>Yerevan · 2026</span>
        </div>
        <h1 id="riviera-title">
          <span>Long lunch.</span>
          <span>Late match.</span>
        </h1>
        <p>Considered court goods for the hours around play.</p>
        <a class="riviera-button" href="#court-goods">Shop court goods <span>↓</span></a>
      </div>

      <figure class="riviera-hero__media">
        <picture>
          <source media="(max-width: 700px)" srcset="/images/riviera/laundry-hero-mobile.avif" type="image/avif" />
          <source media="(max-width: 700px)" srcset="/images/riviera/laundry-hero-mobile.webp" type="image/webp" />
          <source srcset="/images/riviera/laundry-hero-desktop.avif" type="image/avif" />
          <source srcset="/images/riviera/laundry-hero-desktop.webp" type="image/webp" />
          <img
            src="/images/riviera/laundry-hero-desktop.webp"
            alt="Racquet Habit courtwear hanging from a clothesline in Mediterranean sun"
            fetchpriority="high"
            width="2400"
            height="1291"
          />
        </picture>
        <figcaption>
          <span>Laundry day on court</span>
          <span>Plate 01</span>
        </figcaption>
      </figure>
    </section>

    <section class="riviera-collection" id="court-goods" aria-labelledby="court-goods-title">
      <div class="riviera-collection__head">
        <div>
          <span>Issue 01</span>
          <h2 id="court-goods-title">Court goods</h2>
        </div>
        <p>Three founding pieces for play, lunch and the walk home.</p>
        <a href="/shop">View the complete collection ↗</a>
      </div>

      <div class="riviera-product-grid">
        {products.map((product, index) => (
          <RivieraProductPlate product={product} localImage={localImages[index]} index={index} />
        ))}
      </div>

      <div class="riviera-folio" aria-hidden="true">
        <span>01</span>
        <span>Racquet Habit · Match Annual</span>
      </div>
    </section>
  </div>
</BaseLayout>
