---
type Props = { compact?: boolean; light?: boolean };
const { compact = false, light = false } = Astro.props;
---

<a class:list={["brand-mark", { compact, light }]} href="/" aria-label="Racquet Habit home">
  <span class="brand-mark__word" aria-hidden="true">
    <span>RACQUET</span>
    <em>Habit</em>
  </span>
  {!compact && <small>Tennis Addicts Society · Est. 2026</small>}
</a>
