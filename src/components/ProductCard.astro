---
import type { CatalogProduct } from "../data/catalog";

type Props = {
  product: CatalogProduct;
  index?: number;
  feature?: "standard" | "wide" | "compact";
  priority?: boolean;
};

const { product, feature = "standard", priority = false } = Astro.props;
const priceLabel = product.maxPrice > product.price ? `From $${product.price.toFixed(0)}` : `$${product.price.toFixed(0)}`;
const primaryImage = product.catalogImages[0] || product.image;
const secondaryImage = product.catalogImages[1] || primaryImage;
---

<article
  class:list={["annual-product-card", `annual-product-card--${feature}`]}
  data-product-card
  data-commerce-item
  data-item-id={product.id}
  data-item-name={product.name}
  data-item-price={product.price}
  data-item-category={product.category}
  data-item-type={product.productType}
  data-item-capsule={product.capsule}
  data-item-variant={product.variants.find((variant) => variant.inStock)?.name || ""}
  data-category={product.category}
  data-capsule={product.capsule}
>
  <a
    class="annual-product-card__image"
    href={`/products/${product.slug}`}
    aria-label={`View ${product.name}`}
    style={`--product-transition: product-${product.slug}`}
  >
    <img
      class="annual-product-card__primary"
      src={primaryImage}
      alt={product.name}
      loading={priority ? "eager" : "lazy"}
      decoding="async"
      fetchpriority={priority ? "high" : "low"}
      width="1536"
      height="2048"
    />
    {secondaryImage !== primaryImage && (
      <img
        class="annual-product-card__secondary"
        src={secondaryImage}
        alt=""
        aria-hidden="true"
        loading="lazy"
        decoding="async"
        width="1536"
        height="2048"
      />
    )}
  </a>
  <div class="annual-product-card__meta">
    <div>
      <h2><a href={`/products/${product.slug}`}>{product.name}</a></h2>
      <span>{product.productType}{product.featuredColor ? ` · ${product.featuredColor}` : ""}</span>
    </div>
    <strong data-price-usd={product.price}>{priceLabel}</strong>
  </div>
</article>
