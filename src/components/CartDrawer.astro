<dialog class="cart-drawer" data-cart-dialog aria-labelledby="bag-title">
  <form method="dialog" class="cart-drawer__head">
    <h2 id="bag-title">Bag <sup data-cart-count>0</sup></h2>
    <button type="submit" class="icon-button" aria-label="Close shopping bag">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 5 14 14M19 5 5 19" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>
    </button>
  </form>
  <div class="cart-drawer__body" data-cart-items></div>
  <div class="cart-empty" data-cart-empty>
    <img src="/brand-white-court/monogram-thin.webp" alt="" aria-hidden="true" width="1200" height="1200" />
    <h3>Your bag is empty.</h3>
    <p>The full collection is ready for the next court booking.</p>
    <a class="paper-link" href="/shop">Shop all products <span>↗</span></a>
  </div>
  <div class="cart-drawer__foot" data-cart-summary hidden>
    <div class="cart-total"><span>Estimated total</span><strong data-cart-total>$0.00</strong></div>
    <p data-cart-shipping>Worldwide delivery calculated at checkout</p>
    <a class="paper-button paper-button--full" href="#" data-cart-checkout>Secure checkout <span>↗</span></a>
    <small>Continue to secure checkout. Prices and checkout are in USD.</small>
  </div>
</dialog>
