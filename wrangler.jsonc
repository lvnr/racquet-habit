{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "racquet-habit",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist"
  },
  "vars": {
    "AMD_PER_USD": "367",
    "GA_MEASUREMENT_ID": "G-B53YGNVTNF",
    "META_PIXEL_ID": "3719611174858822",
    "TIKTOK_PIXEL_ID": "D9HKESBC77U1LOVTV5E0",
    "PINTEREST_TAG_ID": "2613520753193",
    "PINTEREST_AD_ACCOUNT_ID": "549770622978"
  },
  "routes": [
    {
      "pattern": "racquethabit.com",
      "custom_domain": true
    },
    {
      "pattern": "www.racquethabit.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
