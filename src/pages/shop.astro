---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageMasthead from "../components/PageMasthead.astro";
import ProductCard from "../components/ProductCard.astro";
import { getCatalog } from "../lib/catalog";

const catalog = await getCatalog();
const categories = ["All", "Tees", "Accessories"];
const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "The Racquet Habit collection",
  url: "https://racquethabit.com/shop",
  description: "Tennis tees, caps, totes, towels and accessories for repeat players.",
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: catalog.length,
    itemListElement: catalog.map((product, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: `https://racquethabit.com/products/${product.slug}`,
      name: product.name,
    })),
  },
};
---

<BaseLayout
  title="Tennis Apparel & Court Accessories | Racquet Habit"
  description="Explore tennis tees, caps, totes, towels and court accessories for repeat players, with worldwide delivery and free standard shipping on orders of $150 or more."
  schema={collectionSchema}
>
  <PageMasthead
    title="Shop"
    intro="The complete Racquet Habit collection: considered apparel and court goods for play, lunch and the walk home."
  >
    <span class="page-masthead__count"><b data-visible-count>{catalog.length}</b> products</span>
  </PageMasthead>

  <div class="annual-filter-bar">
    <div class="annual-filter-list" role="group" aria-label="Filter products">
      {categories.map((category) => (
        <button type="button" class={category === "All" ? "active" : ""} data-filter={category}>{category}</button>
      ))}
    </div>
    <span>Front view · Back view on hover</span>
  </div>

  <section class="shop-annual" aria-label="All products">
    {catalog.length > 0 ? (
      <div
        class="annual-product-grid annual-product-grid--shop"
        data-shop-grid
        data-commerce-list
        data-item-list-id="all_products"
        data-item-list-name="All products"
      >
        {catalog.map((product, index) => <ProductCard product={product} index={index} priority={index < 4} />)}
      </div>
    ) : (
      <div class="catalog-unavailable">
        <h2>The live collection is temporarily unavailable.</h2>
        <p>No placeholders are shown. Please return shortly and the collection will reappear automatically.</p>
        <a class="paper-button" href="/contact">Contact us <span aria-hidden="true">↗</span></a>
      </div>
    )}
  </section>

  <section class="shop-editorial" aria-label="Racquet Habit on court">
    <img
      src="/images/products/white-court/racquets-sunshine-something-cold-beach-towel/editorial-02.webp"
      alt="A player courtside wrapped in the Racquets Sunshine Something Cold beach towel"
      loading="lazy"
      decoding="async"
      width="1024"
      height="1536"
    />
    <div>
      <img src="/brand-white-court/monogram-thin.webp" alt="" aria-hidden="true" width="1200" height="1200" />
      <p>Made to order.<br />Worldwide delivery.<br />Quality guaranteed.</p>
      <a class="text-link" href="/shipping">Delivery & returns <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <script>
    const filters = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
    const cards = document.querySelectorAll<HTMLElement>("[data-product-card]");
    const count = document.querySelector<HTMLElement>("[data-visible-count]");
    const params = new URLSearchParams(location.search);

    const apply = (category: string) => {
      let visible = 0;
      filters.forEach((button) => button.classList.toggle("active", button.dataset.filter === category));
      cards.forEach((card) => {
        const show = category === "All" || card.dataset.category === category;
        card.hidden = !show;
        if (show) visible += 1;
      });
      if (count) count.textContent = String(visible);
      const url = new URL(location.href);
      url.searchParams.delete("category");
      url.searchParams.delete("capsule");
      if (category !== "All") url.searchParams.set("category", category);
      history.replaceState({}, "", url);
      (window as any).RacquetHabitAnalytics?.trackVisibleLists(document.querySelector("[data-shop-grid]") || document);
    };

    filters.forEach((button) => button.addEventListener("click", () => apply(button.dataset.filter || "All")));
    apply(params.get("category") || "All");
  </script>
</BaseLayout>
