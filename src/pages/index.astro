---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import { getCatalog } from "../lib/catalog";

const catalog = await getCatalog();
const featured = catalog.filter((product) => !product.comingSoon).slice(0, 4);
---

<BaseLayout>
  <section class="campaign-hero">
    <picture class="campaign-hero__media">
      <source media="(max-width: 700px)" srcset="/images/v2/campaign-hero-close.webp" type="image/webp" />
      <source srcset="/images/v2/campaign-hero.webp" type="image/webp" />
      <source media="(max-width: 700px)" srcset="/images/v2/campaign-hero-close.png" />
      <img src="/images/v2/campaign-hero.png" alt="Tennis player in championship whites on a sunlit green court" fetchpriority="high" />
    </picture>
    <div class="campaign-hero__shade"></div>
    <div class="campaign-hero__wordmark" aria-label="Racquet Habit">
      <span>RACQUET</span><em>Habit</em>
    </div>
    <div class="campaign-hero__meta eyebrow"><span>Tennis Addicts Society</span><span>Yerevan · Est. 2026</span></div>
    <div class="campaign-hero__content">
      <p>The unofficial society for people who always have time for one more set.</p>
      <a class="button button--ivory" href="/shop">View Collection 01 <span>↗</span></a>
    </div>
  </section>

  <div class="championship-band" aria-hidden="true"></div>

  <section class="collection-intro">
    <div class="collection-intro__meta eyebrow"><span>Collection 01</span><span>Yerevan / 2026</span></div>
    <div>
      <h1>The Last <em>Set.</em></h1>
      <p>Considered courtwear and clubhouse objects for repeat players. Tournament manners, contemporary proportions, and just enough wit in the small print.</p>
    </div>
  </section>

  <section class="collection-preview">
    <div class="product-grid product-grid--home">
      {featured.map((product, index) => <ProductCard product={product} index={index} featured={index === 0} />)}
    </div>
    <div class="collection-preview__foot"><span>{featured.length} founding pieces shown</span><a class="text-link" href="/shop">Shop the complete collection <span>↗</span></a></div>
  </section>

  <section class="last-set-statement">
    <img src="/brand-v2/logo-racquet-flourish.svg" alt="" />
    <span class="eyebrow">Society principle no. 01</span>
    <h2>The last set<br />is a <em>myth.</em></h2>
    <p>We said one more set two sets ago.</p>
  </section>

  <section class="editorial-feature">
    <figure><picture><source srcset="/images/v2/court-still-life.webp" type="image/webp" /><img src="/images/v2/court-still-life.png" alt="Racquet Habit court objects arranged in sunlight" loading="lazy" /></picture></figure>
    <div class="editorial-feature__copy">
      <span class="eyebrow">After the match</span>
      <h2>Built for the hours around play.</h2>
      <p>Racquet Habit lives between match point and the next booking: the cap by the door, the towel in the bag, the coffee that outlasts the warm-up.</p>
      <div class="object-row" aria-hidden="true"><img src="/brand-v2/illustration-ball-can.svg" alt="" /><img src="/brand-v2/illustration-towel.svg" alt="" /><img src="/brand-v2/illustration-court-bag.svg" alt="" /></div>
      <a class="text-link" href="/our-habit">About the Society <span>↗</span></a>
    </div>
  </section>

  <section class="journal-teaser">
    <div class="journal-teaser__copy">
      <span class="eyebrow">Court Notes · No. 001</span>
      <h2>A difficult habit to break.</h2>
      <p>It starts with one booking. Then another racquet, a preferred grip, and a weather app checked with unreasonable frequency.</p>
      <a class="button button--green" href="/journal/manifesto">Read the first note <span>↗</span></a>
    </div>
    <figure><picture><source srcset="/images/v2/tournament-poster.webp" type="image/webp" /><img src="/images/v2/tournament-poster.png" alt="Collection 01 tournament poster artwork" loading="lazy" /></picture><figcaption>Collection artwork / green, ivory, royal trim, service red</figcaption></figure>
  </section>

  <section class="society-register-intro">
    <img src="/brand-v2/logo-oval-seal.svg" alt="Racquet Habit Tennis Addicts Society, established 2026" loading="lazy" />
    <div><span class="eyebrow">Members in good standing</span><h2>Properly dressed.<br />Poorly restrained.</h2><p>No gatekeeping, no borrowed aristocracy. If the final set keeps developing sequels, you already belong.</p></div>
  </section>
</BaseLayout>
